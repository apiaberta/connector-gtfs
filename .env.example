PORT=3018
NODE_ENV=production
MONGO_URI=mongodb://localhost:27017/apiaberta-gtfs
GTFS_WINDOW_DAYS=2
# Optional comma-separated feed ids (carris matches carris-metropolitana)
# GTFS_FEEDS=carris,metro-lisboa,cp,fertagus,metro-porto,stcp
# Full ingest cron (Europe/Lisbon). Default 04:00 so it does not overlap connector-geo at 03:30.
# GTFS_INGEST_CRON=0 4 * * *
# Departure window roll.
# GTFS_DEPARTURES_CRON=5 0 * * *
# Tests and `npm run dev` must not point MONGO_URI at production.
